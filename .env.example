# Copy to .env and fill in your own values. Never commit .env.

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only needed for admin operations in src/infrastructure/supabase/client.server.ts
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (browser; inlined at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI reply drafts via @lovable.dev/ai-gateway (server only)
LOVABLE_API_KEY=

# Optional: cron route authentication and Drizzle migrations
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
LOVABLE_DB_MIGRATION_URL=

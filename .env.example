# Copy to .env.local (or .env). Restart Next.js after editing.
# Required browser configuration: Supabase project URL and publishable key.
# Never use a service-role or secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server overrides; default to the public values above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only needed for trusted server admin operations; never expose to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# Optional cron authentication and Drizzle database migrations.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
DATABASE_URL=

# Optional apology drafting only. Credentials stay on the server.
# Groq is used only to generate unpublished drafts for staff review.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
